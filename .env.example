# Runtime: use the Supabase transaction pooler endpoint (normally port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
# Migrations only: use the direct/session endpoint, never the runtime pool.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"
PRISMA_CONNECTION_LIMIT="5"
PRISMA_POOL_TIMEOUT="20"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FINGERPRINT_SALT="replace-with-a-different-random-secret"
CRON_SECRET="replace-with-a-long-random-secret"
# Optional: set to 1 only when startup cache warm-up is managed externally.
DISABLE_PUBLIC_ROUTE_WARMUP="0"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_ID=""

VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
NEXT_PUBLIC_VK_APP_ID=""

RESEND_API_KEY=""
EMAIL_FROM=""
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# Shop. Keep the store disabled until the legal review and Platega adapter are complete.
# Generate exactly 32 random bytes and store them as base64 or 64 hexadecimal characters.
SHOP_DATA_ENCRYPTION_KEY=""
SHOP_PAYMENT_PROVIDER=""
PLATEGA_MERCHANT_ID=""
PLATEGA_SECRET=""
PLATEGA_WEBHOOK_SECRET=""
