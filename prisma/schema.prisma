generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  FOUNDER
  ORGANIZER
  ADMIN
  JUDGE
  TRAINEE
  PLAYER
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  LEAGUE
  GROUPS
  GROUPS_PLAYOFF
  CUSTOM
}

enum TournamentParticipantMode {
  SINGLE
  COOP
  TEAM
}

enum MatchupFormat {
  SINGLE_MATCH
  BEST_OF
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  AWAITING_START
  IN_PROGRESS
  COMPLETED
}

enum MatchStatus {
  PENDING
  READY
  RESULT_SUBMITTED
  CONFIRMED
  REJECTED
  FORFEIT
  CANCELLED
  SCHEDULED
  LIVE
  DISPUTED
  FINISHED
}

enum NotificationType {
  TOURNAMENT
  MATCH
  RESULT
  SYSTEM
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  WAITLIST
  REJECTED
  REMOVED
}

enum TournamentApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StageType {
  LEAGUE
  GROUP_STAGE
  PLAYOFF
}

enum StageStatus {
  DRAFT
  PENDING
  ACTIVE
  COMPLETED
}

enum PlayoffType {
  SINGLE
  DOUBLE
}

enum SeedingMethod {
  MANUAL
  RANDOM
  RANKING
  GROUP_RESULTS
}

enum SortRule {
  POINTS
  GOAL_DIFFERENCE
  GOALS_FOR
  HEAD_TO_HEAD
  WINS
}

enum ClubSelectionMode {
  PLAYER_PICK
  ADMIN_RANDOM
}

enum MatchResultStatus {
  PENDING
  CONFIRMED
  REJECTED
  DISPUTED
}

enum AdminActionType {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  GENERATE
  APPROVE
  REJECT
  RESCHEDULE
  FORFEIT
}

enum LoginAttemptStatus {
  SUCCESS
  FAILED
}

enum VerificationCodePurpose {
  EMAIL_CONFIRMATION
  PASSWORD_CHANGE
  ACCOUNT_DELETION
}

enum ProfileStatusType {
  SEASON_CHAMPION
  SEASON_VICE_CHAMPION
  SEASON_BRONZE
  CURRENT_CHAMPION
  LEGEND
  ACTIVE
  RELIABLE
  GOAL_MASTER
  AMBASSADOR
}

enum ProfileStatusTone {
  GOLD
  PURPLE
  BLUE
  GREEN
  GRAY
}

enum ProfileStatusApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReliabilityEventType {
  RESULT_CONFIRMATION
  CONFIRMATION_STREAK_BONUS
  CLEAN_MATCH_STREAK_BONUS
  TECHNICAL_LOSS
  TECHNICAL_LOSS_REPEAT
  DISPUTE_FALSE_SCORE
  DISPUTE_BOTH_SUSPICIOUS
  DISPUTE_NO_EVIDENCE
  TOURNAMENT_REMOVAL_VIOLATION
  REPLACEMENT_FORFEIT
  REPLACEMENT_CIRCUMSTANCES
  RESTRICTION_STARTED
  RESTRICTION_RECOVERY
  MANUAL_ADJUSTMENT
}

enum ReliabilityPenaltyScope {
  SCORE_SUBMISSION
  PLAYER_REPLACEMENT
  TECHNICAL_LOSS
}

enum FaqAttachmentKind {
  IMAGE
  FILE
  VIDEO
  LINK
}

enum DivisionMatchStatus {
  WAITING_GAME
  WAITING_CONFIRMATION
  DISPUTED
  FINISHED
  CANCELLED
}

enum DivisionMatchResult {
  WIN
  DRAW
  LOSS
}

enum DivisionSeasonStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  FINISHED
}

enum ShopProductType {
  IN_GAME
  PROMOTIONAL
}

enum ShopStockMode {
  FINITE
  UNLIMITED
}

enum ShopProductFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  PLATFORM
  REGION
  LOGIN_METHOD
  TIME
}

enum ShopDiscountType {
  PERCENT
  FIXED
}

enum ShopOrderStatus {
  PENDING_PAYMENT
  PAID
  WAITING_SELLER
  ACCEPTED
  IN_PROGRESS
  SELLER_COMPLETED
  WAITING_BUYER_CONFIRMATION
  COMPLETED
  DISPUTE
  CANCELLED
  REFUND_PENDING
  REFUNDED
  EXPIRED
}

enum ShopOrderActorType {
  BUYER
  SELLER
  SUPPORT
  ADMIN
  SYSTEM
}

enum ShopOrderMessageVisibility {
  PARTICIPANTS
  SUPPORT
  INTERNAL
}

enum ShopPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ShopRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ShopPayoutStatus {
  HELD
  AVAILABLE
  PROCESSING
  PAID
  CANCELLED
}

enum ShopReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum ShopDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum ShopNotificationChannel {
  IN_APP
  TELEGRAM
  EMAIL
  PUSH
}

enum ShopNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum ShopSellerDistributionMode {
  MANUAL
  ROUND_ROBIN
  LOWEST_LOAD
  BEST_RATING
  FASTEST
}

enum ShopJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                                         String                              @id @default(cuid())
  publicId                                   String                              @unique
  name                                       String?
  nameUpdatedAt                              DateTime?
  email                                      String?                             @unique
  emailVerified                              DateTime?
  image                                      String?
  bannerImage                                String?
  bio                                        String?                             @db.Text
  passwordHash                               String?
  favoriteTeam                               String?
  timeZone                                   String?
  timeZoneUpdatedAt                          DateTime?
  telegramId                                 String?                             @unique
  telegramUsername                           String?
  telegram2faEnabled                         Boolean                             @default(false)
  telegram2faEnabledAt                       DateTime?
  vkId                                       String?                             @unique
  role                                       UserRole                            @default(PLAYER)
  isBanned                                   Boolean                             @default(false)
  banReason                                  String?                             @db.Text
  bannedUntil                                DateTime?
  bannedAt                                   DateTime?
  legalAcceptedAt                            DateTime?
  legalAcceptedVersion                       String?
  legalAcceptedIp                            String?
  legalAcceptedUserAgent                     String?                             @db.Text
  dateOfBirth                                DateTime?                           @db.Date
  termsAcceptedAt                            DateTime?
  termsAcceptedVersion                       String?
  personalDataConsentAt                      DateTime?
  personalDataConsentVersion                 String?
  personalDataConsentIp                      String?
  personalDataConsentUserAgent               String?                             @db.Text
  publicDataConsentAt                        DateTime?
  publicDataConsentVersion                   String?
  publicDataConsentIp                        String?
  publicDataConsentUserAgent                 String?                             @db.Text
  publicDataConsentCategories                String[]                            @default([])
  guardianFullName                           String?
  guardianEmail                              String?
  guardianConsentAt                          DateTime?
  guardianConsentVersion                     String?
  guardianConsentIp                          String?
  guardianConsentUserAgent                   String?                             @db.Text
  reliabilityScore                           Int                                 @default(100)
  reliabilityRestrictedUntil                 DateTime?
  reliabilityConfirmStreak                   Int                                 @default(0)
  reliabilityCleanMatchStreak                Int                                 @default(0)
  createdAt                                  DateTime                            @default(now())
  updatedAt                                  DateTime                            @updatedAt
  accounts                                   Account[]
  sessions                                   Session[]
  tournamentEntries                          TournamentRegistration[]
  tournamentRosterMemberships                TournamentRegistrationMember[]
  tournamentRegistrationApplications         TournamentRegistrationApplication[] @relation("registrationApplicant")
  reviewedTournamentRegistrationApplications TournamentRegistrationApplication[] @relation("registrationReviewer")
  playerOneMatches                           Match[]                             @relation("playerOne")
  playerTwoMatches                           Match[]                             @relation("playerTwo")
  winningMatches                             Match[]                             @relation("winner")
  matchLineupEntries                         MatchLineupPlayer[]
  submittedResults                           MatchResultSubmission[]
  notifications                              Notification[]
  webPushSubscriptions                       WebPushSubscription[]
  achievements                               UserAchievement[]
  warningsReceived                           UserWarning[]                       @relation("warningTarget")
  warningsIssued                             UserWarning[]                       @relation("warningIssuer")
  passwordResetTokens                        PasswordResetToken[]
  emailVerificationCodes                     EmailVerificationCode[]
  telegramCallbackTokens                     TelegramCallbackToken[]
  adminActions                               AdminAction[]
  securitySessions                           SecuritySession[]
  loginHistory                               LoginHistory[]
  twoFactorChallenges                        TwoFactorChallenge[]
  profileStatuses                            UserProfileStatus[]                 @relation("profileStatusOwner")
  reviewedProfileStatuses                    UserProfileStatus[]                 @relation("profileStatusReviewer")
  divisionProfile                            DivisionPlayer?
  divisionQueueEntries                       DivisionQueueEntry[]
  divisionMatchesAsOne                       DivisionMatch[]                     @relation("divisionPlayerOne")
  divisionMatchesAsTwo                       DivisionMatch[]                     @relation("divisionPlayerTwo")
  divisionScoreSubmissions                   DivisionScoreSubmission[]
  divisionSeasonArchives                     DivisionSeasonArchive[]
  reliabilityEvents                          ReliabilityEvent[]                  @relation("reliabilityTarget")
  reliabilityEventsIssued                    ReliabilityEvent[]                  @relation("reliabilityActor")
  shopOrders                                 ShopOrder[]                         @relation("shopOrderBuyer")
  shopSeller                                 ShopSeller?
  shopOrderStatusChanges                     ShopOrderStatusHistory[]            @relation("shopStatusActor")
  shopOrderMessages                          ShopOrderMessage[]                  @relation("shopOrderMessageSender")
  shopReviews                                ShopReview[]                        @relation("shopReviewBuyer")
  shopDisputesOpened                         ShopDispute[]                       @relation("shopDisputeOpener")
  shopDisputeMessages                        ShopDisputeMessage[]                @relation("shopDisputeMessageSender")
  shopPromoCodeUsages                        ShopPromoCodeUsage[]
  shopNotifications                          ShopNotification[]
  shopAuditLogs                              ShopAuditLog[]                      @relation("shopAuditActor")

  @@index([role, isBanned, createdAt])
}

model ReliabilityEvent {
  id           String               @id @default(cuid())
  userId       String
  actorId      String?
  type         ReliabilityEventType
  delta        Int
  scoreBefore  Int
  scoreAfter   Int
  reason       String
  comment      String?              @db.Text
  dedupeKey    String?
  matchId      String?
  tournamentId String?
  createdAt    DateTime             @default(now())
  user         User                 @relation("reliabilityTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?                @relation("reliabilityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([matchId])
  @@index([tournamentId])
}

model ReliabilityPenaltyReason {
  id          String                  @id @default(cuid())
  title       String
  description String?                 @db.Text
  points      Int
  scope       ReliabilityPenaltyScope
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([scope, isActive])
  @@index([createdAt])
}

model DivisionSettings {
  id            String    @id @default("default")
  betaEnabled   Boolean   @default(true)
  coverImage    String?
  phaseStartsAt DateTime?
  phaseEndsAt   DateTime?
  rulesText     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DivisionSeason {
  id         String                  @id @default(cuid())
  name       String
  status     DivisionSeasonStatus    @default(SCHEDULED)
  startsAt   DateTime
  endsAt     DateTime
  startedAt  DateTime?
  finishedAt DateTime?
  pausedAt   DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  archives   DivisionSeasonArchive[]

  @@index([status, startsAt, endsAt])
  @@index([createdAt])
}

model DivisionSeasonArchive {
  id            String         @id @default(cuid())
  seasonId      String
  userId        String
  division      Int
  points        Int
  rating        Int?
  wins          Int
  draws         Int
  losses        Int
  winStreak     Int
  bestWinStreak Int
  place         Int?
  createdAt     DateTime       @default(now())
  season        DivisionSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([seasonId, division, place])
  @@index([userId])
}

model DivisionPlayer {
  id            String                 @id @default(cuid())
  userId        String                 @unique
  division      Int                    @default(5)
  points        Int                    @default(0)
  rating        Int?
  wins          Int                    @default(0)
  draws         Int                    @default(0)
  losses        Int                    @default(0)
  winStreak     Int                    @default(0)
  bestWinStreak Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  history       DivisionMatchHistory[]

  @@index([division, points])
  @@index([division, rating])
  @@index([wins, losses])
}

model DivisionQueueEntry {
  id        String   @id @default(cuid())
  userId    String   @unique
  group     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([group, createdAt])
}

model DivisionMatch {
  id             String                    @id @default(cuid())
  playerOneId    String
  playerTwoId    String
  playerOneScore Int?
  playerTwoScore Int?
  status         DivisionMatchStatus       @default(WAITING_GAME)
  deadlineAt     DateTime
  finishedAt     DateTime?
  autoResolved   Boolean                   @default(false)
  adminNote      String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  playerOne      User                      @relation("divisionPlayerOne", fields: [playerOneId], references: [id], onDelete: Cascade)
  playerTwo      User                      @relation("divisionPlayerTwo", fields: [playerTwoId], references: [id], onDelete: Cascade)
  submissions    DivisionScoreSubmission[]
  history        DivisionMatchHistory[]

  @@index([status, deadlineAt])
  @@index([playerOneId, createdAt])
  @@index([playerTwoId, createdAt])
}

model DivisionScoreSubmission {
  id             String        @id @default(cuid())
  matchId        String
  submittedById  String
  playerOneScore Int
  playerTwoScore Int
  screenshotUrl  String?       @db.Text
  createdAt      DateTime      @default(now())
  match          DivisionMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedBy    User          @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@unique([matchId, submittedById])
  @@index([matchId, createdAt])
}

model DivisionMatchHistory {
  id             String              @id @default(cuid())
  matchId        String
  playerId       String
  opponentId     String
  result         DivisionMatchResult
  playerScore    Int
  opponentScore  Int
  divisionBefore Int
  divisionAfter  Int
  pointsBefore   Int?
  pointsAfter    Int?
  ratingBefore   Int?
  ratingAfter    Int?
  delta          Int
  createdAt      DateTime            @default(now())
  match          DivisionMatch       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player         DivisionPlayer      @relation(fields: [playerId], references: [userId], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId, createdAt])
  @@index([createdAt])
}

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@index([role, enabled])
}

model UserWarning {
  id         String   @id @default(cuid())
  userId     String
  issuedById String
  reason     String?  @db.Text
  createdAt  DateTime @default(now())
  user       User     @relation("warningTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy   User     @relation("warningIssuer", fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([issuedById, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
}

model EmailVerificationCode {
  id        String                  @id @default(cuid())
  userId    String
  email     String
  purpose   VerificationCodePurpose @default(EMAIL_CONFIRMATION)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email, purpose, createdAt])
  @@index([email, expiresAt])
}

model Season {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String?             @db.Text
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tournaments     Tournament[]
  profileStatuses UserProfileStatus[]

  @@index([isActive])
}

model UserProfileStatus {
  id                  String                      @id @default(cuid())
  userId              String
  seasonId            String?
  type                ProfileStatusType
  title               String
  description         String                      @db.Text
  tone                ProfileStatusTone           @default(GRAY)
  youtubeUrl          String?
  youtubeChannelTitle String?
  sourceRank          Int?
  approvalStatus      ProfileStatusApprovalStatus @default(PENDING)
  selectedOrder       Int?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  approvedAt          DateTime?
  expiresAt           DateTime?
  expiredNotifiedAt   DateTime?
  reviewedAt          DateTime?
  reviewedById        String?
  user                User                        @relation("profileStatusOwner", fields: [userId], references: [id], onDelete: Cascade)
  season              Season?                     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  reviewedBy          User?                       @relation("profileStatusReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, seasonId, type])
  @@index([userId, approvalStatus, selectedOrder])
  @@index([approvalStatus, createdAt])
  @@index([approvalStatus, expiresAt, expiredNotifiedAt], map: "UserProfileStatus_approvalStatus_expiresAt_expiredNotifiedAt_id")
  @@index([seasonId, sourceRank])
}

model Tournament {
  id                             String                              @id @default(cuid())
  seasonId                       String?
  slug                           String                              @unique
  title                          String
  description                    String                              @db.Text
  rules                          String                              @db.Text
  coverImage                     String?
  lineupPhotoExampleUrl          String?                             @db.Text
  prizePool                      String?
  format                         TournamentFormat
  formatBlueprintJson            Json?
  playoffType                    PlayoffType?
  playoffLegs                    Int                                 @default(1)
  playoffThirdPlace              Boolean                             @default(false)
  seedingMethod                  SeedingMethod                       @default(MANUAL)
  status                         TournamentStatus                    @default(DRAFT)
  startsAt                       DateTime
  endsAt                         DateTime?
  registrationStartsAt           DateTime?
  registrationEndsAt             DateTime
  registrationClosedAt           DateTime?
  checkInRequired                Boolean                             @default(false)
  requireTelegramForRegistration Boolean                             @default(true)
  requireLineupPhoto             Boolean                             @default(false)
  notificationsEnabled           Boolean                             @default(true)
  telegramCommunityId            String?
  telegramChannelId              String?
  telegramGroupId                String?
  telegramAutoPublish            Boolean                             @default(false)
  isTest                         Boolean                             @default(false)
  participantMode                TournamentParticipantMode           @default(SINGLE)
  rosterSize                     Int                                 @default(1)
  topRankingRestrictionEnabled   Boolean                             @default(false)
  topRankingLimit                Int                                 @default(10)
  topRankingPlayerLimit          Int                                 @default(1)
  captainsCreateTeamMatches      Boolean                             @default(false)
  matchupFormat                  MatchupFormat                       @default(SINGLE_MATCH)
  bestOfWins                     Int                                 @default(1)
  autoCreateMatches              Boolean                             @default(true)
  autoCreateStages               Boolean                             @default(true)
  autoCreateSchedule             Boolean                             @default(false)
  autoOpenRegistration           Boolean                             @default(false)
  autoAdvanceFromGroups          Boolean                             @default(false)
  manualBracketControl           Boolean                             @default(false)
  manualPlayoffSelection         Boolean                             @default(false)
  clubSelectionMode              ClubSelectionMode                   @default(ADMIN_RANDOM)
  clubSelectionByLeague          Boolean                             @default(false)
  clubSelectionInGameOnly        Boolean                             @default(true)
  maxParticipants                Int
  pointsForWin                   Int                                 @default(3)
  pointsForDraw                  Int                                 @default(1)
  pointsForLoss                  Int                                 @default(0)
  roundsInLeague                 Int                                 @default(1)
  groupsCount                    Int?
  participantsPerGroup           Int?
  playoffTeamsPerGroup           Int?
  sortRules                      SortRule[]                          @default([POINTS, GOAL_DIFFERENCE, GOALS_FOR, WINS])
  createdById                    String?
  createdAt                      DateTime                            @default(now())
  updatedAt                      DateTime                            @updatedAt
  season                         Season?                             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  participants                   TournamentRegistration[]
  registrationApplications       TournamentRegistrationApplication[]
  rosterMembers                  TournamentRegistrationMember[]
  matches                        Match[]
  stages                         TournamentStage[]
  deadlines                      RoundDeadline[]
  brackets                       PlayoffBracket[]
  actions                        AdminAction[]
  telegramPublications           TelegramPublication[]
  selectedLeagues                TournamentLeague[]

  @@index([status, startsAt])
  @@index([seasonId, status])
  @@index([participantMode, status])
  @@index([isTest, status])
}

model League {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  badgePath          String
  isEnabled          Boolean            @default(true)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  clubs              Club[]
  tournamentLeagues  TournamentLeague[]

  @@index([isEnabled, sortOrder])
}

model Club {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  name                 String
  imagePath            String
  leagueId             String?
  isRegistrationEnabled Boolean    @default(true)
  isInGameEnabled      Boolean     @default(true)
  sortOrder            Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  league               League?     @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  @@index([leagueId, isRegistrationEnabled, isInGameEnabled])
  @@index([isRegistrationEnabled, isInGameEnabled, name])
}

model TournamentLeague {
  id           String     @id @default(cuid())
  tournamentId String
  leagueId     String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  league       League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, leagueId])
  @@index([leagueId])
}

model TelegramPublication {
  id           String     @id @default(cuid())
  tournamentId String
  chatId       String
  messageId    String
  kind         String
  contentHash  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, chatId, kind])
  @@index([tournamentId, updatedAt])
  @@index([chatId, kind])
}

model TournamentRegistrationApplication {
  id              String                      @id @default(cuid())
  tournamentId    String
  userId          String
  status          TournamentApplicationStatus @default(PENDING)
  clubSlug        String?
  clubName        String?
  clubBadgePath   String?
  teamName        String?
  teamLogo        String?
  lineupPhotoUrl  String                      @db.Text
  rejectionReason String?                     @db.Text
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
