model ShopOrderStatusHistory {
  id                String             @id @default(cuid())
  orderId           String
  actorUserId       String?
  actorType         ShopOrderActorType
  previousStatus    ShopOrderStatus
  newStatus         ShopOrderStatus
  comment           String?            @db.Text
  reason            String?
  technicalInfoJson Json?
  createdAt         DateTime           @default(now())
  order             ShopOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor             User?              @relation("shopStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}

model ShopOrderMessage {
  id             String                     @id @default(cuid())
  orderId        String
  senderId       String
  body           String                     @db.Text
  visibility     ShopOrderMessageVisibility @default(PARTICIPANTS)
  attachmentUrl  String?                    @db.Text
  attachmentType String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  deletedAt      DateTime?
  order          ShopOrder                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender         User                       @relation("shopOrderMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([orderId, visibility, createdAt])
  @@index([senderId, createdAt])
}

model ShopSeller {
  id                        String                     @id @default(cuid())
  userId                    String                     @unique
  isActive                  Boolean                    @default(true)
  isOnline                  Boolean                    @default(false)
  distributionMode          ShopSellerDistributionMode @default(LOWEST_LOAD)
  maxActiveOrders           Int                        @default(3)
  commissionBps             Int                        @default(3000)
  ratingAverage             Decimal                    @default(0) @db.Decimal(3, 2)
  ratingCount               Int                        @default(0)
  completedOrders           Int                        @default(0)
  averageFulfillmentMinutes Int                        @default(0)
  lastAssignedAt            DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products                  ShopSellerProduct[]
  schedules                 ShopSellerSchedule[]
  orders                    ShopOrder[]
  reviews                   ShopReview[]
  payouts                   ShopPayout[]

  @@index([isActive, isOnline, lastAssignedAt])
  @@index([deletedAt])
}

model ShopSellerProduct {
  sellerId  String
  productId String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  seller    ShopSeller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([sellerId, productId])
  @@index([productId, isActive])
}

model ShopSellerSchedule {
  id           String     @id @default(cuid())
  sellerId     String
  dayOfWeek    Int
  startsMinute Int
  endsMinute   Int
  timeZone     String     @default("Europe/Moscow")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  seller       ShopSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, dayOfWeek, isActive])
}

model ShopPayment {
  id                String            @id @default(cuid())
  orderId           String
  provider          String
  externalPaymentId String?           @unique
  idempotencyKey    String            @unique
  status            ShopPaymentStatus @default(PENDING)
  amountMinor       Int
  currency          String            @default("RUB")
  checkoutUrl       String?           @db.Text
  expiresAt         DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  providerPayload   Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             ShopOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds           ShopRefund[]

  @@index([orderId, status])
  @@index([provider, status, createdAt])
}

model ShopPaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payloadHash String
  status      String    @default("PROCESSING")
  error       String?   @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([status, createdAt])
}

model ShopRefund {
  id               String           @id @default(cuid())
  orderId          String
  paymentId        String
  externalRefundId String?          @unique
  idempotencyKey   String           @unique
  status           ShopRefundStatus @default(PENDING)
  amountMinor      Int
  currency         String           @default("RUB")
  reason           String           @db.Text
  requestedById    String
  processedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  order            ShopOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment          ShopPayment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([paymentId, status])
}

model ShopPayout {
  id          String           @id @default(cuid())
  orderId     String           @unique
  sellerId    String
  status      ShopPayoutStatus @default(HELD)
  amountMinor Int
  currency    String           @default("RUB")
  availableAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  order       ShopOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller      ShopSeller       @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId, status, availableAt])
}

model ShopReview {
  id            String            @id @default(cuid())
  orderId       String            @unique
  productId     String
  sellerId      String?
  buyerId       String
  rating        Int
  body          String            @db.Text
  tags          String[]          @default([])
  status        ShopReviewStatus  @default(PENDING)
  buyerName     String
  publishedAt   DateTime?
  editableUntil DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  order         ShopOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product       ShopProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller        ShopSeller?       @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  buyer         User              @relation("shopReviewBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  media         ShopReviewMedia[]

  @@index([productId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([buyerId, createdAt])
}

model ShopReviewMedia {
  id        String     @id @default(cuid())
  reviewId  String
  url       String     @db.Text
  mimeType  String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  review    ShopReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
}

model ShopDispute {
  id                    String               @id @default(cuid())
  orderId               String
  openedById            String
  status                ShopDisputeStatus    @default(OPEN)
  reason                String
  description           String               @db.Text
  desiredResolution     String?
  resolution            String?              @db.Text
  resolutionAmountMinor Int?
  resolvedById          String?
  resolvedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  order                 ShopOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  openedBy              User                 @relation("shopDisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  messages              ShopDisputeMessage[]

  @@index([orderId, status, createdAt])
  @@index([status, createdAt])
}

model ShopDisputeMessage {
  id             String      @id @default(cuid())
  disputeId      String
  senderId       String
  body           String      @db.Text
  attachmentUrl  String?     @db.Text
  attachmentType String?
  isInternal     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  dispute        ShopDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender         User        @relation("shopDisputeMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
  @@index([senderId, createdAt])
}

model ShopPromoCode {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  description          String?
  discountType         ShopDiscountType
  discountValue        Int
  minimumSubtotalMinor Int                     @default(0)
  maximumDiscountMinor Int?
  startsAt             DateTime
  endsAt               DateTime
  totalUsageLimit      Int?
  perUserUsageLimit    Int                     @default(1)
  newUsersOnly         Boolean                 @default(false)
  isActive             Boolean                 @default(true)
  createdById          String?
  updatedById          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
  orders               ShopOrder[]
  products             ShopPromoCodeProduct[]
  categories           ShopPromoCodeCategory[]
  usages               ShopPromoCodeUsage[]

  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
}

model ShopPromoCodeProduct {
  promoCodeId String
  productId   String
  promoCode   ShopPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  product     ShopProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, productId])
  @@index([productId])
}

model ShopPromoCodeCategory {
  promoCodeId String
  categoryId  String
  promoCode   ShopPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  category    ShopCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, categoryId])
  @@index([categoryId])
}

model ShopPromoCodeUsage {
  id          String        @id @default(cuid())
  promoCodeId String
  userId      String
  orderId     String        @unique
  amountMinor Int
  createdAt   DateTime      @default(now())
  promoCode   ShopPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  order       ShopOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([promoCodeId, createdAt])
  @@index([promoCodeId, userId, createdAt])
  @@index([userId, createdAt])
}

model ShopNotification {
  id          String                  @id @default(cuid())
  orderId     String?
  userId      String
  channel     ShopNotificationChannel
  event       String
  status      ShopNotificationStatus  @default(PENDING)
  templateKey String
  payload     Json
  dedupeKey   String                  @unique
  attempts    Int                     @default(0)
  availableAt DateTime                @default(now())
  lockedAt    DateTime?
  lockToken   String?
  sentAt      DateTime?
  lastError   String?                 @db.Text
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  order       ShopOrder?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([userId, createdAt])
  @@index([orderId, event])
}

model ShopAuditLog {
  id          String     @id @default(cuid())
  actorUserId String?
  orderId     String?
  entityType  String
  entityId    String
  action      String
  beforeJson  Json?
  afterJson   Json?
  reason      String?
  ipAddress   String?
  userAgent   String?    @db.Text
  createdAt   DateTime   @default(now())
  actor       User?      @relation("shopAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  order       ShopOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([orderId, createdAt])
}

model ShopSettings {
  id                         String   @id @default("default")
  isEnabled                  Boolean  @default(false)
  maintenanceMode            Boolean  @default(false)
  showHomeBlock              Boolean  @default(true)
  currency                   String   @default("RUB")
  minimumOrderMinor          Int      @default(1000)
  maximumOrderMinor          Int      @default(100000000)
  paymentTimeoutMinutes      Int      @default(15)
  sellerAcceptTimeoutMinutes Int      @default(10)
  fulfillmentTimeoutMinutes  Int      @default(60)
  buyerConfirmTimeoutMinutes Int      @default(1440)
  autoCompleteEnabled        Boolean  @default(false)
  reviewEditWindowHours      Int      @default(24)
  reviewModerationEnabled    Boolean  @default(true)
  reviewImagesEnabled        Boolean  @default(true)
  cancellationEnabled        Boolean  @default(true)
  showSellerToBuyer          Boolean  @default(false)
  defaultCommissionBps       Int      @default(3000)
  supportTelegramChatId      String?
  reviewsTelegramChatId      String?
  reviewsTelegramUrl         String?
  supportContact             String?
  termsVersion               String   @default("shop-draft-1")
  legalTextsJson             Json?
  updatedById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model ShopJob {
  id          String        @id @default(cuid())
  type        String
  dedupeKey   String        @unique
  payload     Json
  status      ShopJobStatus @default(PENDING)
  attempts    Int           @default(0)
  availableAt DateTime      @default(now())
  lockedAt    DateTime?
  lockToken   String?
  completedAt DateTime?
  lastError   String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, availableAt])
  @@index([type, status])
}
